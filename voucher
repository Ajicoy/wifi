                    <label for="pilihanPaket" class="form-label fw-semibold">Paket Voucher</label>
                    <select class="form-select" id="pilihanPaket" required onchange="updateSummary()">
                      <option value="" selected disabled>-- Pilih Paket --</option>
                      <option value="1jam">Paket 1 Jam - Rp 2.000</option>
                      <option value="24jam">Paket 24 Jam - Rp 10.000</option>
                      <option value="7hari">Paket 7 Hari - Rp 50.000</option>
