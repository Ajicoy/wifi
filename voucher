            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button collapsed" data-bs-toggle="collapse" data-bs-target="#f3">Satu voucher bisa untuk berapa perangkat?</button></h2>
              <div id="f3" class="accordion-collapse collapse" data-bs-parent="#faqAcc"><div class="accordion-body text-secondary">Satu voucher berlaku untuk satu perangkat dalam satu waktu.</div></div>
            </div>
