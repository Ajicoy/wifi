                <path d="M2 8.8a15 15 0 0 1 20 0"/><path d="M5 12.5a10.5 10.5 0 0 1 14 0"/><path d="M8.5 16a5.5 5.5 0 0 1 7 0"/><circle cx="12" cy="19.5" r="1" fill="#fff"/>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Stats -->
  <section class="stats">
    <div class="container">
      <div class="row g-3">
        <div class="col-6 col-md-3"><div class="stat-card"><h3>30 Mbps</h3><small>Kecepatan maksimal</small></div></div>
        <div class="col-6 col-md-3"><div class="stat-card"><h3>24/7</h3><small>Jaringan aktif</small></div></div>
        <div class="col-6 col-md-3"><div class="stat-card"><h3>1.000+</h3><small>Voucher terjual</small></div></div>
        <div class="col-6 col-md-3"><div class="stat-card"><h3>Instan</h3><small>Kode via WhatsApp</small></div></div>
      </div>
    </div>
  </section>

