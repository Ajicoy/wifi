        </ul>
        <span class="status-pill"><span class="dot"></span>Jaringan Online</span>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <header class="hero">
    <div class="container">
      <div class="row align-items-center g-5">
        <div class="col-lg-7 text-center text-lg-start">
          <span class="badge rounded-pill bg-warning text-dark mb-3 px-3 py-2">🔥 Voucher mulai Rp 2.000</span>
          <h1>Internet Ngebut Tanpa Ribet, Cukup Beli <span class="hl">Voucher</span></h1>
