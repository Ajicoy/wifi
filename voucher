  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const paketData = {
      '1jam': { nama: 'Paket 1 Jam', harga: 'Rp 2.000' },
      '24jam': { nama: 'Paket 24 Jam', harga: 'Rp 10.000' },
      '7hari': { nama: 'Paket 7 Hari', harga: 'Rp 50.000' }
    };

    function updateSummary() {
      const key = document.getElementById('pilihanPaket').value;
      document.getElementById('summaryHarga').innerText = key ? paketData[key].harga : 'Rp 0';
    }

    function selectPackage(key) {
      document.getElementById('pilihanPaket').value = key;
      updateSummary();
      document.getElementById('form-checkout').scrollIntoView({ behavior: 'smooth' });
    }

    document.getElementById('checkoutForm').addEventListener('submit', function (e) {
      e.preventDefault();
      const nama = document.getElementById('namaLengkap').value;
      const wa = document.getElementById('noWhatsapp').value;
      const key = document.getElementById('pilihanPaket').value;
      const method = document.querySelector('input[name="paymentMethod"]:checked').value;
      if (!key) { alert('Silakan pilih paket voucher terlebih dahulu.'); return; }

      const info = paketData[key];
      document.getElementById('modalNama').innerText = nama;
      document.getElementById('modalWA').innerText = wa;
      document.getElementById('modalPaket').innerText = info.nama;
      document.getElementById('modalHarga').innerText = info.harga;

      const box = document.getElementById('paymentDetails');
      if (method === 'transfer') {
        box.innerHTML = `
          <p class="mb-2">Transfer sesuai nominal ke rekening berikut:</p>
          <div class="p-3 rounded-3 border border-primary">
            <small class="text-muted">Bank BCA</small>
            <h4 class="fw-bold my-1">123-456-7890</h4>
            <small class="text-secondary">a.n. WiFi Panji (contoh)</small>
          </div>`;
      } else {
        box.innerHTML = `
          <p class="mb-2">Scan QRIS dengan aplikasi e-wallet / mobile banking:</p>
          <div class="p-3 border rounded-3 d-inline-block bg-white">
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=SIMULASI-QRIS-WIFI-PANJI" alt="QRIS" class="img-fluid">
          </div>`;
      }
      new bootstrap.Modal(document.getElementById('paymentModal')).show();
    });

    function simulasiSukses() {
      alert('Pembayaran Berhasil! Kode voucher WiFi telah dikirimkan ke nomor WhatsApp Anda.');
      bootstrap.Modal.getInstance(document.getElementById('paymentModal')).hide();
      document.getElementById('checkoutForm').reset();
      updateSummary();
    }
  </script>
