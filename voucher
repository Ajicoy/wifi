              <button class="btn btn-outline-primary w-100 rounded-pill fw-semibold py-2" onclick="selectPackage('1jam')">Beli Paket</button>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="ticket popular">
            <div class="ribbon">POPULER</div>
            <div class="ticket-top"><div class="dur">🌙 Paket 24 Jam</div><div class="price">Rp 10.000</div></div>
            <div class="ticket-cut"></div>
            <div class="ticket-body">
              <ul><li>Masa aktif 24 jam penuh</li><li>Kecepatan hingga 20 Mbps</li><li>Streaming & video call lancar</li></ul>
              <button class="btn btn-buy w-100 rounded-pill" onclick="selectPackage('24jam')">Beli Paket</button>
            </div>
          </div>
        </div>
        <div class="col-md-6 col-lg-4">
          <div class="ticket third">
            <div class="ticket-top"><div class="dur">🚀 Paket 7 Hari</div><div class="price">Rp 50.000</div></div>
            <div class="ticket-cut"></div>
            <div class="ticket-body">
              <ul><li>Masa aktif 7 hari</li><li>Kecepatan hingga 30 Mbps</li><li>Paling hemat untuk seminggu</li></ul>
              <button class="btn btn-outline-primary w-100 rounded-pill fw-semibold py-2" onclick="selectPackage('7hari')">Beli Paket</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Cara beli -->
  <section class="py-5" id="cara" style="background:#fff;">
    <div class="container py-4">
      <div class="sec-title">
        <span class="tag">CARA BELI</span>
        <h2>Online dalam 4 Langkah</h2>
      </div>
      <div class="row g-4">
        <div class="col-6 col-lg-3 step"><div class="num">1</div><h6 class="fw-bold">Pilih Paket</h6><small class="text-secondary">Tentukan durasi yang kamu butuhkan.</small></div>
        <div class="col-6 col-lg-3 step"><div class="num">2</div><h6 class="fw-bold">Isi Data</h6><small class="text-secondary">Masukkan nama dan nomor WhatsApp.</small></div>
        <div class="col-6 col-lg-3 step"><div class="num">3</div><h6 class="fw-bold">Bayar</h6><small class="text-secondary">Transfer bank atau QRIS / e-wallet.</small></div>
        <div class="col-6 col-lg-3 step"><div class="num">4</div><h6 class="fw-bold">Login WiFi</h6><small class="text-secondary">Masukkan kode voucher di halaman login.</small></div>
      </div>
    </div>
  </section>

  <!-- Checkout -->
