  <section class="py-5 mt-4" id="keunggulan">
    <div class="container py-4">
      <div class="sec-title">
        <span class="tag">KEUNGGULAN</span>
        <h2>Kenapa Pilih WiFi Panji?</h2>
      </div>
      <div class="row g-4">
        <div class="col-6 col-lg-3"><div class="feat"><div class="ico">⚡</div><h6 class="fw-bold">Cepat & Stabil</h6><small class="text-secondary">Koneksi lancar untuk streaming, meeting, dan game.</small></div></div>
        <div class="col-6 col-lg-3"><div class="feat"><div class="ico">💸</div><h6 class="fw-bold">Harga Terjangkau</h6><small class="text-secondary">Mulai dari Rp 2.000, pas di kantong pelajar.</small></div></div>
        <div class="col-6 col-lg-3"><div class="feat"><div class="ico">📲</div><h6 class="fw-bold">Kode Instan</h6><small class="text-secondary">Bayar, kode voucher langsung dikirim ke WhatsApp.</small></div></div>
        <div class="col-6 col-lg-3"><div class="feat"><div class="ico">🛟</div><h6 class="fw-bold">Support Ramah</h6><small class="text-secondary">Ada kendala? Admin siap bantu cepat.</small></div></div>
      </div>
    </div>
  </section>

  <!-- Paket -->
  <section class="py-5" id="paket">
    <div class="container py-4">
      <div class="sec-title">
        <span class="tag">PAKET VOUCHER</span>
        <h2>Pilih Paket Sesuai Kebutuhan</h2>
        <p class="text-secondary">Tanpa kontrak, tanpa langganan. Beli, pakai, selesai.</p>
      </div>
