<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WiFi Panji - Beli Voucher Internet Cepat & Murah</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --brand: #0d6efd;
      --brand-dark: #0a3fa8;
      --accent: #ffc107;
      --ink: #0f1b3d;
    }
    * { font-family: 'Poppins', sans-serif; }
    body { background: #f4f7ff; color: var(--ink); scroll-behavior: smooth; }
    html { scroll-behavior: smooth; }

    /* Navbar */
    .navbar { background: rgba(10, 30, 90, .92); backdrop-filter: blur(8px); }
    .navbar-brand { font-weight: 800; letter-spacing: .5px; }
    .navbar-brand span { color: var(--accent); }
    .nav-link { color: #dbe6ff !important; font-weight: 500; }
    .nav-link:hover { color: #fff !important; }
    .status-pill { background: rgba(25,195,125,.18); color: #3ee6a0; border: 1px solid rgba(62,230,160,.4);
      padding: 4px 12px; border-radius: 50px; font-size: .78rem; font-weight: 600; }
    .dot { display:inline-block; width:8px; height:8px; background:#3ee6a0; border-radius:50%; margin-right:6px; animation: pulse 1.6s infinite; }
    @keyframes pulse { 0%{box-shadow:0 0 0 0 rgba(62,230,160,.7);} 70%{box-shadow:0 0 0 8px rgba(62,230,160,0);} 100%{box-shadow:0 0 0 0 rgba(62,230,160,0);} }

    /* Hero */
    .hero {
      position: relative; overflow: hidden; color: #fff; padding: 140px 0 120px;
      background: radial-gradient(circle at 20% 20%, #1e5bff 0%, transparent 45%),
                  radial-gradient(circle at 85% 70%, #7a3cff 0%, transparent 45%),
                  linear-gradient(135deg, #081a4d, #0b2a7a);
    }
    .hero::after { content:""; position:absolute; left:0; right:0; bottom:-1px; height:90px;
      background: #f4f7ff; clip-path: ellipse(75% 100% at 50% 100%); }
    .hero h1 { font-weight: 800; font-size: clamp(2rem, 5vw, 3.4rem); line-height: 1.15; }
    .hero h1 .hl { color: var(--accent); }
    .hero p.lead { color: #cfdcff; max-width: 520px; }
    .btn-accent { background: var(--accent); color: #1a1a1a; font-weight: 700; border: none; border-radius: 50px; padding: 12px 30px; box-shadow: 0 8px 24px rgba(255,193,7,.35); }
    .btn-accent:hover { background: #ffcd39; transform: translateY(-2px); }
    .btn-ghost { border: 2px solid rgba(255,255,255,.5); color: #fff; border-radius: 50px; padding: 10px 28px; font-weight: 600; }
    .btn-ghost:hover { background: #fff; color: var(--brand-dark); }
    .wifi-art { position: relative; width: 280px; height: 280px; margin: auto; }
    .wifi-art .ring { position:absolute; inset:0; border-radius:50%; border:2px solid rgba(255,255,255,.25); animation: ripple 3.2s infinite; }
    .wifi-art .ring:nth-child(2){ animation-delay: 1s; }
    .wifi-art .ring:nth-child(3){ animation-delay: 2s; }
    @keyframes ripple { 0%{transform:scale(.35); opacity:1;} 100%{transform:scale(1.15); opacity:0;} }
    .wifi-art .core { position:absolute; inset:70px; border-radius:50%; background: linear-gradient(135deg,#ffd447,#ff9f1a);
      display:flex; align-items:center; justify-content:center; box-shadow: 0 20px 50px rgba(255,159,26,.5); }
    .wifi-art svg { width: 70px; height: 70px; }

    /* Stats */
    .stats { margin-top: -70px; position: relative; z-index: 5; }
    .stat-card { background:#fff; border-radius: 18px; padding: 22px; text-align:center; box-shadow: 0 12px 35px rgba(13,60,170,.12); }
    .stat-card h3 { font-weight: 800; color: var(--brand); margin: 0; }
    .stat-card small { color:#6b7691; }

    /* Section title */
    .sec-title { text-align:center; margin-bottom: 40px; }
    .sec-title .tag { display:inline-block; background:#e6eeff; color:var(--brand); font-weight:600; font-size:.8rem; padding:5px 14px; border-radius:50px; margin-bottom:10px; }
    .sec-title h2 { font-weight: 800; }

    /* Features */
    .feat { background:#fff; border-radius: 18px; padding: 28px 22px; height:100%; text-align:center; transition:.3s; border:1px solid #e8eeff; }
    .feat:hover { transform: translateY(-6px); box-shadow: 0 16px 36px rgba(13,60,170,.12); }
    .feat .ico { width:64px; height:64px; margin:0 auto 14px; border-radius:18px; display:flex; align-items:center; justify-content:center; font-size:1.8rem;
      background: linear-gradient(135deg,#e6eeff,#d4e1ff); }

    /* Pricing - voucher ticket style */
    .ticket { position: relative; background:#fff; border-radius: 22px; overflow: hidden; height:100%; transition:.3s; box-shadow: 0 10px 30px rgba(13,60,170,.1); border: 2px solid transparent; }
    .ticket:hover { transform: translateY(-8px); box-shadow: 0 20px 45px rgba(13,60,170,.2); }
    .ticket.popular { border-color: var(--accent); }
    .ticket-top { padding: 26px 20px 22px; color:#fff; text-align:center;
      background: linear-gradient(135deg, #0d6efd, #0a3fa8); }
    .ticket.popular .ticket-top { background: linear-gradient(135deg, #7a3cff, #0d6efd); }
    .ticket.third .ticket-top { background: linear-gradient(135deg, #0aa37f, #0d6efd); }
    .ticket-top .dur { font-weight: 700; font-size: 1.15rem; }
    .ticket-top .price { font-size: 2.3rem; font-weight: 800; line-height: 1.1; margin-top: 6px; }
    .ticket-top .price small { font-size: .9rem; font-weight: 500; opacity:.85; }
    .ticket-cut { position:relative; height: 0; border-top: 2px dashed #cfd9f5; margin: 0 22px; }
    .ticket-cut::before, .ticket-cut::after { content:""; position:absolute; top:-14px; width:26px; height:26px; background:#f4f7ff; border-radius:50%; }
    .ticket-cut::before { left:-35px; } .ticket-cut::after { right:-35px; }
    .ticket-body { padding: 24px 24px 28px; }
    .ticket-body ul { list-style:none; padding:0; margin:0 0 20px; }
    .ticket-body li { padding: 7px 0; color:#4a5575; font-size:.93rem; }
    .ticket-body li::before { content:"✓"; color:#19b97a; font-weight:800; margin-right:10px; }
    .ribbon { position:absolute; top: 16px; right: -38px; background: var(--accent); color:#222; font-weight:700; font-size:.72rem; padding: 5px 44px; transform: rotate(40deg); z-index:3; }

    /* Steps */
    .step { text-align:center; padding: 10px 18px; }
    .step .num { width:60px; height:60px; border-radius:50%; margin:0 auto 14px; display:flex; align-items:center; justify-content:center;
      font-weight:800; font-size:1.4rem; color:#fff; background: linear-gradient(135deg, var(--brand), #7a3cff); box-shadow: 0 10px 24px rgba(13,110,253,.35); }

    /* Checkout */
    .checkout-wrap { background: linear-gradient(135deg, #081a4d, #0b2a7a); border-radius: 28px; padding: 14px; box-shadow: 0 25px 60px rgba(8,26,77,.35); }
    .checkout-card { background:#fff; border-radius: 20px; padding: 34px; }
    .form-control, .form-select { border-radius: 12px; padding: 12px 16px; border: 1.5px solid #dfe6fa; }
    .form-control:focus, .form-select:focus { border-color: var(--brand); box-shadow: 0 0 0 .22rem rgba(13,110,253,.15); }
    .pay-opt input { display:none; }
    .pay-opt label { display:block; border:2px solid #dfe6fa; border-radius:14px; padding: 14px; text-align:center; cursor:pointer; font-weight:600; transition:.2s; }
    .pay-opt input:checked + label { border-color: var(--brand); background:#eef4ff; color: var(--brand); }
    .btn-buy { background: linear-gradient(135deg,#0d6efd,#7a3cff); color:#fff; font-weight:700; border:none; border-radius: 14px; padding: 15px; box-shadow: 0 10px 26px rgba(13,110,253,.4); }
    .btn-buy:hover { color:#fff; transform: translateY(-2px); filter: brightness(1.08); }
    .summary { background:#f4f7ff; border-radius: 14px; padding: 14px 18px; display:flex; justify-content:space-between; align-items:center; }

    /* Testimoni */
    .testi { background:#fff; border-radius:18px; padding: 24px; height:100%; box-shadow: 0 8px 26px rgba(13,60,170,.08); }
    .avatar { width:46px; height:46px; border-radius:50%; background: linear-gradient(135deg,var(--brand),#7a3cff); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; }

    /* FAQ */
    .accordion-item { border:none; border-radius: 14px !important; margin-bottom: 12px; overflow:hidden; box-shadow: 0 6px 20px rgba(13,60,170,.07); }
    .accordion-button { font-weight:600; }
    .accordion-button:not(.collapsed) { background:#eef4ff; color: var(--brand); box-shadow:none; }

    /* Footer */
    footer { background: #081a4d; color:#b9c8f2; }
    footer a { color:#b9c8f2; text-decoration:none; }
    footer a:hover { color:#fff; }

    /* Floating WA */
    .wa-float { position:fixed; right:20px; bottom:20px; z-index:99; background:#25d366; color:#fff; width:58px; height:58px; border-radius:50%;
      display:flex; align-items:center; justify-content:center; font-size:1.7rem; text-decoration:none; box-shadow: 0 10px 26px rgba(37,211,102,.5); }
    .wa-float:hover { color:#fff; transform: scale(1.08); }
  </style>
</head>
<body>

  <!-- Navbar -->
  <nav class="navbar navbar-expand-lg navbar-dark fixed-top">
    <div class="container">
      <a class="navbar-brand" href="#">📶 WiFi <span>Panji</span></a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
