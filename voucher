            <h2>Pertanyaan Umum</h2>
          </div>
          <div class="accordion" id="faqAcc">
            <div class="accordion-item">
              <h2 class="accordion-header"><button class="accordion-button" data-bs-toggle="collapse" data-bs-target="#f1">Berapa lama kode voucher dikirim?</button></h2>
